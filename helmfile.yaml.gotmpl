repositories:
- name: argoproj
  url: https://argoproj.github.io/argo-helm
- name: grafana
  url: https://grafana.github.io/helm-charts
- name: strrl.dev
  url: https://helm.strrl.dev

---
# Vault-backed Helmfile
# All secrets are fetched from Vault at deploy time
#
# Required environment variables:
#   CLUSTER_NAME           - Unique cluster identifier (dev, staging, prod, etc)
#   CLUSTER_DOMAIN         - Domain for cluster services (e.g., example.com)
#
# Optional environment variables:
#   CLOUDFLARED_REPLICAS   - Number of cloudflared replicas (default: 1)
#
# All secrets are fetched from Vault:
#   secret/metadata/gitops/{{ CLUSTER_NAME }}/argocd#adminpasswordhashed
#   secret/metadata/gitops/{{ CLUSTER_NAME }}/github#accesstoken
#   secret/metadata/gitops/{{ CLUSTER_NAME }}/cloudflare#apitoken
#   secret/metadata/gitops/{{ CLUSTER_NAME }}/cloudflare#accountid
#   secret/metadata/gitops/{{ CLUSTER_NAME }}/grafana-cloud#token

environments:
  default:
    values:
      - clusterName: {{ env "CLUSTER_NAME" | default "default" }}
        domain: {{ env "CLUSTER_DOMAIN" | default "example.com" }}
        environment: {{ env "CLUSTER_NAME" | default "default" }}
        argocd:
          adminpasswordhashed: {{ fetchSecretValue "ref+vault://secret/metadata/gitops/{{ env "CLUSTER_NAME" | default "default" }}/argocd#adminpasswordhashed" }}
        github:
          accesstoken: {{ fetchSecretValue "ref+vault://secret/metadata/gitops/{{ env "CLUSTER_NAME" | default "default" }}/github#accesstoken" }}
        cloudflare:
          apitoken: {{ fetchSecretValue "ref+vault://secret/metadata/gitops/{{ env "CLUSTER_NAME" | default "default" }}/cloudflare#apitoken" }}
          accountid: {{ fetchSecretValue "ref+vault://secret/metadata/gitops/{{ env "CLUSTER_NAME" | default "default" }}/cloudflare#accountid" }}
        ingressController:
          replicaCount: 1
          cloudflared:
            replicaCount: {{ env "CLOUDFLARED_REPLICAS" | default "1" | atoi }}
            protocol: auto
        grafanaCloud:
          token: {{ fetchSecretValue "ref+vault://secret/metadata/gitops/{{ env "CLUSTER_NAME" | default "default" }}/grafana-cloud#token" }}

---
helmfiles:
  - path: releases/namespaces.yaml.gotmpl
    inherits: [repositories]
    values:
      - {{ .Values | toYaml | nindent 8 }}
  - path: releases/observability.yaml.gotmpl
    inherits: [repositories]
    values:
      - {{ .Values | toYaml | nindent 8 }}
  - path: releases/networking.yaml.gotmpl
    inherits: [repositories]
    values:
      - {{ .Values | toYaml | nindent 8 }}
  - path: releases/argocd.yaml.gotmpl
    inherits: [repositories]
    values:
      - {{ .Values | toYaml | nindent 8 }}
