releases:
  - name: prometheus-operator-crds
    chart: prometheus-community/prometheus-operator-crds
    namespace: monitoring
    forceNamespace: monitoring
    version: 22.0.2

  - name: kube-prometheus-stack
    namespace: monitoring
    forceNamespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: 82.1.0
    values:
      - crds:
          enabled: false
        grafana:
          adminUser: admin
          adminPassword: {{ .Values.grafana.adminpassword }}
          ingress:
            enabled: false
          sidecar:
            datasources:
              enabled: false
            notifiers:
              enabled: false
          datasources:
            datasources.yaml:
              apiVersion: 1
              datasources:
              - name: Prometheus (Local)
                type: prometheus
                url: http://prometheus-operated:9090
                isDefault: true
              - name: Loki
                type: loki
                url: http://loki-gateway.monitoring.svc.cluster.local:80
              - name: Tempo
                type: tempo
                url: http://tempo-query-frontend.monitoring.svc.cluster.local:3200
                jsonData:
                  httpMethod: GET
                  serviceMap:
                    datasourceUid: 'prom'
                  nodeGraph:
                    enabled: true
                  lokiSearch:
                    datasourceUid: 'loki'
        prometheus:
          prometheusSpec:
            enableOTLPReceiver: true
            otlp:
              promoteResourceAttributes:
                - os.type
                - host.name
                - telemetry.sdk.language
                - telemetry.sdk.name
                - session.id
                - deployment.environment
                - service.name
                - service.version
            disableCompaction: false
            retention: {{ .Values.prometheus.retention | default "24h" }}
            tsdb:
              blockDuration: 1h
              outOfOrderTimeWindow: 60s
            serviceMonitorSelectorNilUsesHelmValues: false
            serviceMonitorSelector: {}
            serviceMonitorNamespaceSelector: {}
            storageSpec:
              volumeClaimTemplate:
                spec:
                  storageClassName: "standard"  # Local storage - change to your storage class
                  accessModes: ["ReadWriteOnce"]
                  resources:
                    requests:
                      storage: {{ .Values.prometheus.storageSize | default "20Gi" }}
            additionalScrapeConfigs: []
            additionalScrapeConfigsSecret: {}
            scrapeProtocols:
              - OpenMetricsText0.0.1
              - OpenMetricsText1.0.0
              - PrometheusProto
              - PrometheusText0.0.4
        prometheusOperator:
          kubeletEndpointSliceEnabled: true
          kubeletEndpointsEnabled: false

  - name: metrics-server
    namespace: kube-system
    forceNamespace: kube-system
    chart: metrics-server/metrics-server
    version: 3.13.0

  - name: loki
    namespace: monitoring
    forceNamespace: monitoring
    chart: grafana/loki
    version: 6.35.1
    values:
      - loki:
          auth_enabled: false
          limits_config:
            retention_period: {{ .Values.loki.retention_period | default "24h" }}
          storage:
            type: filesystem
          schemaConfig:
            configs:
              - from: "2024-01-01"
                index:
                  period: 24h
                  prefix: loki_index_
                object_store: filesystem
                schema: v13
                store: tsdb
          derivedFields:
            - datasourceUid: tempo
              matcherRegex: "traceID=(\\w+)"
              name: TraceID
              url: "$${__value.raw}"
        persistence:
          enabled: true
          size: {{ .Values.loki.storageSize | default "10Gi" }}
          storageClassName: "standard"  # Local storage
        serviceAccount:
          create: true

  - name: promtail
    namespace: monitoring
    forceNamespace: monitoring
    chart: grafana/promtail
    version: 6.17.0
    values:
      - config:
          lokiAddress: http://loki-gateway.monitoring.svc.cluster.local/loki/api/v1/push
        serviceMonitor:
          enabled: true

  - name: tempo
    namespace: monitoring
    forceNamespace: monitoring
    chart: grafana/tempo-distributed
    version: 1.61.0
    values:
      - tempo:
          repository: grafana/tempo
          tag: 2.9.0
        storage:
          trace:
            backend: local
            local:
              path: /var/tempo/traces
          admin:
            path: /var/tempo/admin
        persistence:
          enabled: true
          size: {{ .Values.tempo.storageSize | default "10Gi" }}
          storageClassName: "standard"  # Local storage
        metricsGenerator:
          enabled: true
          replicas: {{ .Values.tempo.replicas | default 1 }}
        overrides:
          defaults:
            metrics_generator:
              processors: [service-graphs, span-metrics, local-blocks]
        memcached:
          enabled: false
        traces:
          otlp:
            grpc:
              enabled: true
            http:
              enabled: true

  # Optional: Thanos for long-term storage (only if S3 is configured)
  # Uncomment and configure S3 values if needed
  # - name: thanos
  #   namespace: monitoring
  #   forceNamespace: monitoring
  #   chart: bitnami/thanos
  #   version: 17.3.1
  #   values:
  #     - storage:
  #         objstore:
  #           type: s3
  #           config:
  #             bucket: "my-bucket"
  #             endpoint: "s3.amazonaws.com"
  #             access_key: "{{ .Values.s3.accesskey }}"
  #             secret_key: "{{ .Values.s3.secretkey }}"
