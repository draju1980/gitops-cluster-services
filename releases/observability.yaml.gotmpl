---
releases:
  - name: metrics-server
    namespace: kube-system
    forceNamespace: kube-system
    chart: metrics-server/metrics-server
    version: 3.13.0

  # SecretStore for monitoring namespace to access Vault secrets
  - name: monitoring-secretstore
    namespace: monitoring
    forceNamespace: monitoring
    chart: "git::https://github.com/531001/helm-charts.git@raw?ref=main"
    values:
      - resources:
          - apiVersion: external-secrets.io/v1beta1
            kind: SecretStore
            metadata:
              name: vault
              namespace: monitoring
            spec:
              provider:
                vault:
                  server: {{ requiredEnv "VAULT_ADDR" | quote }}
                  path: {{ .Values.externalVault.path | default "secret" | quote }}
                  version: {{ .Values.externalVault.version | default "v2" | quote }}
                  auth:
                    tokenSecretRef:
                      name: external-secrets-vault-token
                      namespace: external-secrets
                      key: token

          # ExternalSecret to pull Grafana Cloud credentials from Vault
          - apiVersion: external-secrets.io/v1beta1
            kind: ExternalSecret
            metadata:
              name: grafana-cloud-credentials
              namespace: monitoring
            spec:
              refreshInterval: 1h
              secretStoreRef:
                name: vault
                kind: SecretStore
              target:
                name: grafana-cloud-credentials
                creationPolicy: Owner
              data:
                - secretKey: username
                  remoteRef:
                    key: gitops/{{ .Values.environment | default "dev" }}/grafana-cloud
                    property: username
                - secretKey: password
                  remoteRef:
                    key: gitops/{{ .Values.environment | default "dev" }}/grafana-cloud
                    property: password
                - secretKey: url
                  remoteRef:
                    key: gitops/{{ .Values.environment | default "dev" }}/grafana-cloud
                    property: url

  # Grafana k8s-monitoring for comprehensive Kubernetes observability
  - name: grafana-cloud-k8s-monitoring
    namespace: monitoring
    forceNamespace: monitoring
    chart: grafana/k8s-monitoring
    version: 1.8.0
    needs:
      - monitoring/monitoring-secretstore
    values:
      - cluster:
          name: {{ .Values.clusterName | quote }}

        # Remote write configuration for Grafana Cloud Prometheus
        remoteWrite:
          - url: https://prometheus-blocks-prod-us-central1.grafana.net/api/prom/push
            basicAuth:
              username:
                name: grafana-cloud-credentials
                key: username
              password:
                name: grafana-cloud-credentials
                key: password

        # Grafana Loki log aggregation configuration
        logs:
          enabled: true
          cluster_events:
            enabled: true
          pod_logs:
            enabled: true

        loki:
          enabled: true
          clients:
            - url: https://logs-prod-us-central1.grafana.net/loki/api/v1/push
              basicAuth:
                username:
                  name: grafana-cloud-credentials
                  key: username
                password:
                  name: grafana-cloud-credentials
                  key: password

        # Alloy configuration for metrics and traces collection
        alloy:
          remoteConfig:
            enabled: false  # Set to true if using Grafana Agent config management

        # Collectors configuration
        collectors:
          node-exporter:
            enabled: true
          kube-state-metrics:
            enabled: true
          opencost:
            enabled: false
          prometheus-operator:
            enabled: false

        # Service discovery presets
        logging:
          level: {{ .Values.agent.logLevel | default "info" | quote }}

  # Optional: Prometheus Operator for advanced monitoring scenarios
  - name: kube-prometheus-stack
    namespace: monitoring
    forceNamespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: 65.0.0
    installed: false  # Set to true if you need Prometheus Operator
    values:
      - prometheus:
          enabled: false  # Disabled as we use Grafana Cloud
        alertmanager:
          enabled: false
        grafana:
          enabled: false
        kubeApiServer:
          enabled: true
        kubeControllerManager:
          enabled: false
        kubeEtcd:
          enabled: false
        kubeSchedulerAlerting:
          enabled: false
        kubeProxy:
          enabled: false
        kubeStateMetrics:
          enabled: false  # Managed by k8s-monitoring
