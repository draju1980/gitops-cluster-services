---
releases:
  - name: metrics-server
    namespace: kube-system
    forceNamespace: kube-system
    chart: metrics-server/metrics-server
    version: 3.13.0

  # SecretStore for monitoring namespace to access Vault secrets
  - name: monitoring-secretstore
    namespace: monitoring
    forceNamespace: monitoring
    chart: "git::https://github.com/531001/helm-charts.git@raw?ref=main"
    values:
      - resources:
          - apiVersion: external-secrets.io/v1beta1
            kind: SecretStore
            metadata:
              name: vault
              namespace: monitoring
            spec:
              provider:
                vault:
                  server: {{ requiredEnv "VAULT_ADDR" | quote }}
                  path: {{ .Values.externalVault.path | default "secret" | quote }}
                  version: {{ .Values.externalVault.version | default "v2" | quote }}
                  auth:
                    tokenSecretRef:
                      name: external-secrets-vault-token
                      namespace: external-secrets
                      key: token

          # ExternalSecret to pull Grafana Cloud credentials from Vault
          - apiVersion: external-secrets.io/v1beta1
            kind: ExternalSecret
            metadata:
              name: grafana-cloud-credentials
              namespace: monitoring
            spec:
              refreshInterval: 1h
              secretStoreRef:
                name: vault
                kind: SecretStore
              target:
                name: grafana-cloud-credentials
                creationPolicy: Owner
              data:
                - secretKey: username
                  remoteRef:
                    key: gitops/{{ .Values.environment | default "dev" }}/grafana-cloud
                    property: username
                - secretKey: password
                  remoteRef:
                    key: gitops/{{ .Values.environment | default "dev" }}/grafana-cloud
                    property: password
                - secretKey: prometheus-url
                  remoteRef:
                    key: gitops/{{ .Values.environment | default "dev" }}/grafana-cloud
                    property: prometheus-url
                - secretKey: loki-url
                  remoteRef:
                    key: gitops/{{ .Values.environment | default "dev" }}/grafana-cloud
                    property: loki-url
                - secretKey: tempo-url
                  remoteRef:
                    key: gitops/{{ .Values.environment | default "dev" }}/grafana-cloud
                    property: tempo-url

  # Grafana Cloud Alloy Agent
  # Collects all metrics, logs, and traces from the cluster and sends to Grafana Cloud
  - name: grafana-alloy
    namespace: monitoring
    forceNamespace: monitoring
    chart: grafana/alloy
    version: 0.3.1
    values:
      - alloy:
          stability: experimental
          loglevel: {{ .Values.agent.logLevel | default "info" }}
          configMap:
            create: true
            name: alloy-config
          config: |
            logging {
              level  = "{{ .Values.agent.logLevel | default "info" }}"
              format = "json"
            }

            discovery.kubernetes "nodes" {
              role = "node"
            }

            discovery.kubernetes "services" {
              role = "service"
            }

            discovery.kubernetes "endpoints" {
              role = "endpoints"
            }

            discovery.kubernetes "pods" {
              role = "pod"
            }

            // Prometheus Metrics Collection
            prometheus.scrape "kubernetes_pods" {
              targets = discovery.kubernetes.pods.targets
              job_name = "kubernetes-pods"
              scrape_interval = "30s"
              scrape_timeout = "10s"

              metric_relabel "drop_high_cardinality" {
                action = "drop"
                source_labels = ["__name__"]
                regex = "kubelet_volume_stats_used_bytes|kubelet_volume_stats_capacity_bytes"
              }
            }

            prometheus.scrape "kubernetes_nodes" {
              targets = discovery.kubernetes.nodes.targets
              job_name = "kubernetes-nodes"
              scrape_interval = "30s"
              scrape_timeout = "10s"
              bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
              tls_config {
                ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
              }
            }

            prometheus.scrape "kubernetes_services" {
              targets = discovery.kubernetes.services.targets
              job_name = "kubernetes-services"
              scrape_interval = "30s"
              scrape_timeout = "10s"
            }

            // Add cluster name label to all metrics
            prometheus.relabel "add_cluster_label" {
              forward_to = [prometheus.remote_write.grafana_cloud.receiver]
              metric_relabel {
                action = "replace"
                target_label = "cluster"
                replacement = "{{ .Values.clusterName | default "default" }}"
              }
            }

            // Forward metrics to Grafana Cloud
            prometheus.remote_write "grafana_cloud" {
              endpoint {
                url = "{{ .Values.grafanaCloud.prometheusUrl }}"
                basic_auth {
                  username = "{{ .Values.grafanaCloud.username }}"
                  password = "{{ .Values.grafanaCloud.prometheusPassword }}"
                }
              }
            }

            // Logs Collection
            loki.source.kubernetes "pod_logs" {
              targets = discovery.kubernetes.pods.targets
              forward_to = [loki.process.logs.receiver]
            }

            loki.process "logs" {
              stage.label_drop {
                values = ["__meta_kubernetes_pod_label_app_kubernetes_io_version", "__meta_kubernetes_pod_label_app_kubernetes_io_part_of"]
              }
              forward_to = [loki.write.grafana_cloud.receiver]
            }

            loki.write "grafana_cloud" {
              endpoint {
                url = "{{ .Values.grafanaCloud.lokiUrl }}"
                basic_auth {
                  username = "{{ .Values.grafanaCloud.username }}"
                  password = "{{ .Values.grafanaCloud.lokiPassword }}"
                }
              }
            }

            // Traces Collection (optional)
            {{- if and .Values.grafanaCloud.tempoUrl (ne .Values.grafanaCloud.tempoUrl "") }}
            otelcol.receiver.otlp "default" {
              grpc {
                endpoint = "0.0.0.0:4317"
              }
              http {
                endpoint = "0.0.0.0:4318"
              }
              output {
                traces = [otelcol.exporter.otlp.grafana_cloud.input]
              }
            }

            otelcol.exporter.otlp "grafana_cloud" {
              client {
                endpoint = "{{ .Values.grafanaCloud.tempoUrl }}"
                auth = otelcol.auth.basic.grafana_cloud.handler
              }
            }

            otelcol.auth.basic "grafana_cloud" {
              username = "{{ .Values.grafanaCloud.username }}"
              password = "{{ .Values.grafanaCloud.tempoPassword }}"
            }
            {{- end }}

        rbac:
          create: true
        serviceAccount:
          create: true
        podSecurityPolicy:
          create: false
        priorityClassName: system-cluster-critical
        tolerations:
          - key: node-role.kubernetes.io/control-plane
            operator: Exists
            effect: NoSchedule
          - key: node-role.kubernetes.io/master
            operator: Exists
            effect: NoSchedule
        resources:
          requests:
            cpu: 200m
            memory: 256Mi
          limits:
            cpu: 500m
            memory: 512Mi
